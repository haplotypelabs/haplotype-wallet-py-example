# Copy to .env and fill in. Values below are the production defaults.

# Your app's credentials, from Haplotype Labs. Required.
WALLET_CLIENT_ID=
WALLET_CLIENT_SECRET=

# Authorization server (WorkOS AuthKit). Stage: https://great-countryside-82-staging.authkit.app
WALLET_ISSUER=https://authkit.haplotype.ai
# MCP endpoint. Also sent as the OAuth `resource`. Stage: https://api.stage.haplotype.ai/mcp
WALLET_MCP_URL=https://api.haplotype.ai/mcp
# Scopes to request. Wallet scopes must be assigned to your app, or authorize fails with invalid_scope.
# offline_access gives you a refresh token.
WALLET_SCOPES="openid offline_access samples:read"

# Where this app runs. The redirect URI is APP_URL + /callback and must be registered for your app.
APP_URL=http://localhost:8787
PORT=8787

# Signs the session cookie. Optional: a random one is generated per run if empty.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Test-only route for automated tests: POST /debug/expire-token marks the session's
# access token as expired, so the next page view refreshes it. On only when exactly 1.
# EXAMPLE_TEST_HOOKS=1
